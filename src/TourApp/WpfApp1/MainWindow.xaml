<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Туристическое агентство" Height="560" Width="760"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шаг 1: размер массива -->
        <GroupBox Header="1. Размер массива" Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Количество туров:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtSize" Width="60" Margin="8,0" VerticalAlignment="Center"/>
                <Button x:Name="btnCreate" Content="Создать массив" Padding="10,3" Click="BtnCreate_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- Шаг 2: ввод тура -->
        <GroupBox Header="2. Ввод данных тура" Grid.Row="1" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Направление:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtDestination" Width="150" Margin="5,0,12,0" IsEnabled="False"/>
                <TextBlock Text="Дней:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtDuration" Width="50" Margin="5,0,12,0" IsEnabled="False"/>
                <TextBlock Text="Цена:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtPrice" Width="90" Margin="5,0,12,0" IsEnabled="False"/>
                <Button x:Name="btnAdd" Content="Добавить тур" Padding="10,3" IsEnabled="False" Click="BtnAdd_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- Списки -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Header="Неотсортированный набор" Grid.Column="0" Margin="0,0,4,0">
                <ListBox x:Name="lstUnsorted"/>
            </GroupBox>
            <GroupBox Header="Отсортированный набор" Grid.Column="1" Margin="4,0,0,0">
                <ListBox x:Name="lstSorted"/>
            </GroupBox>
        </Grid>

        <!-- Кнопки внизу -->
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnSort" Content="Сортировать" Padding="12,4" IsEnabled="False" Click="BtnSort_Click"/>
                <Button x:Name="btnSave" Content="Сохранить в файл" Padding="12,4" Margin="8,0,0,0" IsEnabled="False" Click="BtnSave_Click"/>
            </StackPanel>
            <TextBlock x:Name="txtStatus" Margin="0,8,0,0" Text="Введите размер массива"/>
        </StackPanel>
    </Grid>
</Window>